<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Primary Meta Tags -->
  <title>{{- title }} | {{- theme.custom_css or config.title }}</title>
  <meta name="title" content="{{- title }} | {{- config.title }}">
  <meta name="description" content="{{- config.description }}">
  <meta name="keywords" content="{{- config.keywords }}">
  <meta name="author" content="{{- config.author }}">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="{{- page.type or 'website' }}">
  <meta property="og:url" content="{{- config.url + page.path }}">
  <meta property="og:title" content="{{- title }} | {{- config.title }}">
  <meta property="og:description" content="{{- page.description or config.description }}">
  <meta property="og:image" content="{{- config.url }}{{- page.banner_img or '/images/og-image.jpg' }}">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:site_name" content="{{- config.title }}">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="{{- config.url + page.path }}">
  <meta property="twitter:title" content="{{- title }} | {{- config.title }}">
  <meta property="twitter:description" content="{{- page.description or config.description }}">
  <meta property="twitter:image" content="{{- config.url }}{{- page.banner_img or '/images/og-image.jpg' }}">

  <!-- Canonical URL -->
  <link rel="canonical" href="{{- config.url + page.path }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="{{- config.url }}{{ theme.favicon or '/favicon.ico' }}">

  <!-- DNS Prefetch -->
  <link rel="dns-prefetch" href="//cdn.jsdelivr.net">

  <!-- RSS Feed -->
  <link rel="alternate" type="application/atom+xml" title="{{ config.title }}" href="{{ config.url }}/atom.xml">

  {{- fragment_cache('head', function() { }}
    {# 百度统计 #}
    {%- if theme.seo and theme.seo.baidu_tongji_id %}
    <script>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?" + "{{ theme.seo.baidu_tongji_id }}";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
    {%- endif %}

    {# Google Analytics #}
    {%- if theme.seo and theme.seo.google_analytics_id %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ theme.seo.google_analytics_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ theme.seo.google_analytics_id }}');
    </script>
    {%- endif %}

    {# Google Search Console Verification #}
    {%- if theme.seo and theme.seo.google_verification %}
    <meta name="google-site-verification" content="{{ theme.seo.google_verification }}">
    {%- endif %}

    {# Baidu Search Platform Verification #}
    {%- if theme.seo and theme.seo.baidu_verification %}
    <meta name="baidu-site-verification" content="{{ theme.seo.baidu_verification }}">
    {%- endif %}
  {{- }) }}

  <!-- Schema.org Organization Markup -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "存勤法税服务（广州）有限公司",
    "alternateName": "存勤法税",
    "url": "https://dengdahua.github.io/cunqin_law-tax/",
    "logo": "https://dengdahua.github.io/cunqin_law-tax/images/logo.png",
    "description": "专注为企业提供涉税风险检查、税务危机应对、ODI备案、企业重组税务规划等专业服务",
    "founder": {
      "@type": "Person",
      "name": "邓达华",
      "jobTitle": "创始人、首席税务顾问",
      "description": "18年财税法实战专家，14年甲方+4年乙方视角",
      "knowsAbout": ["税务筹划", "涉税风险", "企业重组", "跨境投资"]
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+86-13556116691",
      "contactType": "customer service",
      "areaServed": "CN",
      "availableLanguage": ["Chinese", "English"]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "广州",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://zhuanlan.zhihu.com/cunqin",
      "https://weibo.com/cunqin"
    ]
  }
  </script>

  {{- css('css/style.css') }}
  {{- css('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css') }}
</head>
